-- flow-time 1.2.0 — clock formatting helpers.
pad2 :: Int -> Str
pad2 n = if n < 0 then "00" else if n < 10 then "0" + str n else str n

hms :: Int -> Str
hms ms = do
  let total = ms / 1000
  let s = total % 60
  let m = total / 60 % 60
  let h = total / 3600
  pad2 h + ":" + pad2 m + ":" + pad2 s

duration :: Int -> Str
duration ms =
  if ms < 1000
    then str ms + "ms"
    else if ms < 60000
      then str (ms / 1000) + "s"
      else str (ms / 60000) + "m " + pad2 (ms / 1000 % 60) + "s"

isoDate :: Int -> Str
isoDate daysSinceEpoch = do
  let z = daysSinceEpoch + 719468
  let era = (if z >= 0 then z else z - 146096) / 146097
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 then mp + 3 else mp - 9
  let yy = if m <= 2 then y + 1 else y
  str yy + "-" + pad2 m + "-" + pad2 d
